# Copy this file to .env.local and fill in your key.

# Which AI provider to use for the screenshot -> MJML step. Defaults to
# "gemini" (free tier, no card required) if unset. Set to "anthropic" once
# you want to switch to Claude for production-grade quality.
AI_PROVIDER=gemini

# --- Gemini (default, free tier) ---
# Get a key at https://aistudio.google.com/apikey — no payment method needed.
GEMINI_API_KEY=
# Optional override. Defaults to gemini-3.8-flash if unset.
# GEMINI_MODEL=gemini-3.8-flash

# --- Anthropic (paid, used for the feasibility test in docs/feasibility-notes.md) ---
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-sonnet-4-5-20250929 if unset.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
